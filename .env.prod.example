# Copy values into your real backend/.env and webapp/.env.
# Do not commit real secrets.

# Backend required secrets
SECRET_KEY=replace_with_generated_secret
JWT_SECRET_KEY=replace_with_generated_jwt_secret

# Public URLs for nginx local production dry-run
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api
FRONTEND_PUBLIC_URL=http://localhost
BACKEND_PUBLIC_URL=http://localhost/api
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]

# External AI runtimes kept outside Docker in Stage 2
COMFY_URL=http://host.docker.internal:8188
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Stripe placeholders. Put real values only in backend/.env, not here.
LOCAL_CREDIT_PURCHASE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Webapp env
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_BACKEND_URL=http://localhost/api
