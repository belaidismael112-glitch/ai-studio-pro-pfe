# Copy important values from backend/.env and keep secrets private.
# Stage 1 keeps ComfyUI and Ollama outside Docker on the host machine.

FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

COMFY_URL=http://host.docker.internal:8188
OLLAMA_BASE_URL=http://host.docker.internal:11434
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Real Stripe mode
LOCAL_CREDIT_PURCHASE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
