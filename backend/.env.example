# AI Studio Pro V15 — local image-first ComfyUI example
# Copy this file to backend/.env and replace all placeholder secrets.
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-generate-a-long-random-secret
JWT_SECRET_KEY=change-me-generate-a-different-long-random-secret

# Database
# Local direct Python launch:
DATABASE_URL=sqlite:///./ai_studio.db
# Docker Compose alternative (shared volume for backend + worker):
# DATABASE_URL=sqlite:///./data/ai_studio.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://aistudio:strong_password@postgres:5432/aistudio

# URLs
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Image-first AI provider
AI_PROVIDER=comfy
# Direct local Python launch:
COMFY_URL=http://127.0.0.1:8188
# Docker Compose overrides this automatically to http://host.docker.internal:8188
COMFY_IMAGE_CHECKPOINT=flux1-schnell-fp8.safetensors
COMFY_STRICT_WORKFLOW_MODE=true
COMFY_USE_PROMPT_ENGINE=false
COMFY_RANDOM_SEED=true
COMFY_IMAGE_DEFAULT_WIDTH=1280
COMFY_IMAGE_DEFAULT_HEIGHT=720
COMFY_IMAGE_STEPS=8
COMFY_IMAGE_CFG=1.0
COMFY_IMAGE_SAMPLER=euler
COMFY_IMAGE_SCHEDULER=simple
COMFY_IMAGE_TIMEOUT_SECONDS=900

# Optional providers kept for compatibility only
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=
FAL_KEY=

# Assistant / Ollama
ASSISTANT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OPERATOR_USE_OLLAMA=true

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# true = simplest direct local development; false = production worker queue
CELERY_TASK_ALWAYS_EAGER=true

# Credits
CREDIT_COST_IMAGE=10
FREE_TRIAL_CREDITS=100
LOCAL_CREDIT_PURCHASE_ENABLED=true

# Security / upload
ENABLE_SECURITY_HEADERS=true
MAX_UPLOAD_MB=15
PROMPT_MAX_CHARS=8000
PROMPT_MIN_WORDS_FOR_BOOST=4

# Object storage optional
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1
SIGNED_URL_EXPIRE_SECONDS=3600

# Stripe optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Admin seed local only: change before production
INITIAL_ADMIN_EMAIL=admin@aistudio.local
INITIAL_ADMIN_PASSWORD=ChangeMeAdmin123!
INITIAL_ADMIN_FULL_NAME=Main Admin

# Support contact
SUPPORT_ADMIN_NAME=Support
SUPPORT_ADMIN_EMAIL=support@example.com
SUPPORT_ADMIN_PHONE=+000000000

# face-alignment-master
AI_STUDIO_ALLOW_FACE_ALIGNMENT_DOWNLOAD=1
AI_STUDIO_FACE_ALIGNMENT_DEVICE=cpu
AI_STUDIO_FACE_ALIGNMENT_DETECTOR=sfd
